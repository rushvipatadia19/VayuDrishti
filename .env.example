# Tavily Search API (server-side only, for incident web research)
TAVILY_API_KEY=

# OpenRouter API (server-side only, NEVER prefix with NEXT_PUBLIC_)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Hugging Face Inference API (Optional legacy fallback)
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# Supabase (PostgreSQL database & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Unsigned image upload preset for evidence photos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Geoapify (Server-side location autocomplete restricted to India)
GEOAPIFY_API_KEY=

# Base URL (for client fetches)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Hugging Face Inference API (server-side only, NEVER prefix with NEXT_PUBLIC_)
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# Supabase (PostgreSQL database)
NEXT_PUBLIC_SUPABASE_URL=
